{
  "name": "opencluely-overlay",
  "version": "2.5.2",
  "description": "Windows desktop overlay with OpenAI, Claude, Gemini, saved chats and owner-controlled automatic reopening",
  "main": "overlay/main.js",
  "author": "OpenCluely contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/luffy-taro-106/opencluely-overlay.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js",
    "test": "node --test tests/core.test.js tests/models.test.js tests/providers.test.js tests/storage.test.js tests/checkpoint-writer.test.js tests/platform.test.js tests/quit-guard.test.js tests/recovery.test.js tests/interrupted-work.test.js tests/windows-panel.test.js tests/chatgpt-auth.test.js tests/codex.test.js",
    "test:desktop": "node scripts/launch.js --smoke-test",
    "test:interruption": "node scripts/test-interruption.js",
    "test:recovery": "node --test --test-concurrency=1 tests/recovery-native.test.js",
    "icons": "node scripts/create-icons.js",
    "postinstall": "node scripts/create-icons.js",
    "build": "node scripts/build-recovery.js && electron-builder",
    "build:win": "node scripts/build-recovery.js && electron-builder --win nsis --x64",
    "build:portable": "node scripts/build-recovery.js && electron-builder --win portable --x64",
    "pack": "node scripts/build-recovery.js && electron-builder --dir"
  },
  "dependencies": {
    "@openai/codex": "0.164.0",
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.opencluely.overlay",
    "productName": "OpenCluely Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "overlay/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "overlay/native/bin/**",
      "node_modules/@openai/codex-*/vendor/**"
    ],
    "win": {
      "icon": "overlay/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "OpenCluely-Overlay-Setup-${version}.${ext}",
      "customNsisBinary": {
        "url": "https://github.com/electron-userland/electron-builder-binaries/releases/download/nsis%402.0.1/nsis-bundle-3.12.tar.gz",
        "checksum": "fe36a357f3a220db893498e830fd80e0769768a18a99f4e4d2447b982538feed",
        "version": "2.0.1"
      }
    },
    "portable": {
      "artifactName": "OpenCluely-Overlay-Portable-${version}.${ext}"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "npmRebuild": false
  }
}
